{
  "version": 2,
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "FLASK_APP": "run.py",
    "FLASK_ENV": "production",
    "SECRET_KEY": "@secret_key"
  }
}
